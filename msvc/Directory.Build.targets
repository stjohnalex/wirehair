<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    LNK1104 on ab_benchmark_*.exe: another process holds the file (running exe, debugger,
    AV). taskkill alone can leave handles briefly; we wait and retry delete before link.
  -->
  <PropertyGroup>
    <WirehairUnlockBenchmarkScript Condition="'$(WirehairUnlockBenchmarkScript)'==''">$(MSBuildThisFileDirectory)scripts\unlock_benchmark_link.ps1</WirehairUnlockBenchmarkScript>
  </PropertyGroup>
  <Target Name="WirehairAbBenchmarkUnlockBeforeLink"
          BeforeTargets="Link"
          Condition="'$(ConfigurationType)' == 'Application'
                     and $(MSBuildProjectFile.StartsWith('ab_benchmark'))">
    <Message Importance="Low"
             Text="WirehairAbBenchmarkUnlockBeforeLink: $(TargetPath)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(WirehairUnlockBenchmarkScript)&quot; -TargetPath &quot;$(TargetPath)&quot;"
          IgnoreExitCode="true" />
  </Target>
</Project>
